{{> profile-nav editGuardar="Guardar Cambios" editarGuardarRuta="/dashboard"}}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos/forms/forms.css">
    <link rel="stylesheet" href="/estilos/forms/forms-media-queries.css">
    <link rel="shortcut icon" href="/favicon/planet-icon.png" type="image/x-icon">
    <title>{{title}}</title>
</head>
<!--cambiar foto de silver-->
<main id="main-form">
    <h2>{{title}}</h2>

    <form method="POST">


        {{else if isInterests}}

        <label for="interest">Nuevo interés</label>
        <input type="text" id="interest" name="interest" placeholder="{{placeholder}}" maxlength="30" required
            autofocus>

        {{#if interests.length}}
        <div id="interests-added">
            {{#each interests}}
            <span class="interest-chip">{{this}}</span>
            {{/each}}
        </div>
        {{/if}}

        {{else}}

        <button type="submit">{{#if isInterests}}Agregar{{else}}Guardar{{/if}}</button>
    </form>
</main>